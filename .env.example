# LUMI Voice Assistant Environment Variables
# Copy this to .env and fill in values as needed

# Ollama settings (optional overrides)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma3:1b

# Remote LLM API (optional, disabled by default)
# REMOTE_LLM_API_KEY=
# REMOTE_LLM_API_URL=

# Piper TTS voice model path (optional override)
# PIPER_VOICE_MODEL=

# Logging level
# LOG_LEVEL=INFO
